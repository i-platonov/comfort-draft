  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/build-site.mjs && vite build",
    "build:app": "tsc && vite build",
    "preview": "node scripts/serve-dist.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
